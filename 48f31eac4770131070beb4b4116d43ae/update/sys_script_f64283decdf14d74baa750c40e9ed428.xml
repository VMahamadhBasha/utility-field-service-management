        <script><![CDATA[(function executeRule(current, previous) {
    var areaId = current.getValue('area');
    if (areaId) {
        var areaGr = new GlideRecord('x_1966159_utilit_0_area');
        if (areaGr.get(areaId)) {
            var areaType = areaGr.getValue('area_type');
            if (areaType !== 'village') {
                gs.addErrorMessage('A Transformer area must be a Village. City and Street areas are not allowed.');
                current.setAbortAction(true);
            }
        }
    }
})(current, previous);
]]></script>
